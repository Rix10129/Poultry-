# PRODUCTION WORKBOOK - real customer data. NEVER commit it (this repository is public).
# Create it on your PC with SETUP_WINDOWS.bat / "python citylinks.py setup".
data/CITY_LINKS_Recovery.xlsx
data/*.xlsx
!data/DEMO_CITY_LINKS_Recovery.xlsx
__pycache__/
*.pyc
.pytest_cache/
# customer data produced while using the system stays local
backups/*
!backups/.gitkeep
exports/**/*.pdf
exports/**/*.xlsx
imports/*.xlsx
imports/handwritten/*
!imports/handwritten/.gitkeep
~$*.xlsx
